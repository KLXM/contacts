{
    "name": "klxm/contacts",
    "description": "Kontakte für REDAXO: Adressbücher, Listen, eigene Felder, vCard und CardDAV",
    "type": "redaxo-addon",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "KLXM\\Contacts\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KLXM\\Contacts\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    }
}
